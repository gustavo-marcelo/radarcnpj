# Copie para .env e ajuste conforme necessário (os valores abaixo são os padrões).
# O docker-compose.yml lê este arquivo automaticamente.

# --- Segurança ---
# Em produção, use um segredo forte (>= 256 bits) e nunca o mesmo deste exemplo.
APP_JWT_SECRET=docker-radar-cnpj-mude-este-segredo-em-producao-256-bits-minimos
APP_ADMIN_EMAIL=admin@exemplo.com
APP_ADMIN_SENHA=admin123

# --- Build ---
# Repositório do GitHub (owner/repo) de onde o compose baixa o último release.
GITHUB_REPO=gustavo-marcelo/radarcnpj

# --- Dados ---
# Diretório local com os .zip da Receita Federal (mountado em /dados na API).
DADOS_DIR=../dados

# --- Comportamento ---
APP_JWT_EXPIRATION_SECONDS=86400
APP_CORS_ORIGENS=http://localhost:4200,http://localhost
APP_CADASTRO_PUBLICO=false
APP_IMPORT_ENABLED=false
JAVA_OPTS=